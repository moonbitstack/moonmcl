// MoonBit Motion Control Library (moonmcl). The root package is a facade: it
// re-exports the linear-algebra primitives that every module builds on, so a
// caller can write `@moonmcl.Vector` / `@moonmcl.Matrix` and reach for the
// per-module packages (`@moonmcl.control`, ...) as they need them.

import {
  "moonbitstack/moonmcl/linear",
}
