// The facade. It re-exports the public surface of every package, so a caller can
// import the library once under any alias (the examples use `mctl`) and reach
// the whole of it as `@mctl.Pid`, `@mctl.Rrt`, `@mctl.Vec`, and so on. Each
// package can still be imported on its own by its own path.

import {
  "moonbitstack/moonmcl/linear",
  "moonbitstack/moonmcl/contract",
  "moonbitstack/moonmcl/control",
  "moonbitstack/moonmcl/estimation",
  "moonbitstack/moonmcl/trajectory",
  "moonbitstack/moonmcl/planning",
  "moonbitstack/moonmcl/kinematics",
}
