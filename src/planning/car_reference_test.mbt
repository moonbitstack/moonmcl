// The two car models against the reference implementations: the shortest length
// and the pose at even distances along the path. The tables are generated by
// `scripts/vectors/gen_dubins.py` and `scripts/vectors/gen_reeds_shepp.py`.

///|
fn angle_close(a : Double, b : Double, tolerance~ : Double = 1.0e-9) -> Bool {
  @math.atan2(@math.sin(a - b), @math.cos(a - b)).abs() <= tolerance
}

///|
fn pose_close(
  pose : @linear.Vec,
  expected : Array[Double],
  tolerance~ : Double = 1.0e-9,
) -> Bool {
  close(pose.get(0), expected[0], tolerance~) &&
  close(pose.get(1), expected[1], tolerance~) &&
  angle_close(pose.get(2), expected[2], tolerance~)
}

///|
test "dubins paths match the reference length and every sampled pose" {
  let cases = dubins_cases()
  assert_eq(cases.length() >= 25, true)
  for case in cases {
    let car = @planning.Dubins::new(turning_radius=case.radius)
    let path = car.path(
      start=@linear.Vec::of(case.start),
      goal=@linear.Vec::of(case.goal),
    )
    assert_eq(close(path.length, case.length), true)
    for k in 0..<case.samples.length() {
      let distance = case.length *
        k.to_double() /
        (case.samples.length() - 1).to_double()
      let pose = path.at(distance)
      assert_eq(pose_close(pose, case.samples[k]), true)
    }
  }
}

///|
test "reeds shepp paths match the reference length, cusps and sampled poses" {
  let cases = reeds_shepp_cases()
  assert_eq(cases.length() >= 25, true)
  for case in cases {
    let car = @planning.ReedsShepp::new(turning_radius=case.radius)
    let path = car.path(
      start=@linear.Vec::of(case.start),
      goal=@linear.Vec::of(case.goal),
    )
    assert_eq(close(path.length, case.length), true)
    assert_eq(path.cusps(), case.cusps)
    for k in 0..<case.samples.length() {
      // A sample carries the distance the reference walked to reach it.
      let sample = case.samples[k]
      let expected : Array[Double] = [sample[1], sample[2], sample[3]]
      assert_eq(
        pose_close(path.at(sample[0]), expected, tolerance=1.0e-9),
        true,
      )
    }
  }
}
