// The planar arm against a mature robotics toolbox: forward kinematics for arms
// of two, three and four links, and the tip the reference's own forward map puts a
// solved configuration at. The table is generated by
// `scripts/vectors/gen_pythonrobotics.py`.

///|
test "forward kinematics matches the reference tip" {
  let cases = pythonrobotics_arm_cases()
  assert_eq(cases.length() >= 9, true)
  for case in cases {
    let arm = @kinematics.PlanarArm::new(lengths=case.links)
    let tip = arm.forward(@linear.Vec::of(case.angles))
    assert_eq((tip.get(0) - case.tip[0]).abs() <= 1.0e-12, true)
    assert_eq((tip.get(1) - case.tip[1]).abs() <= 1.0e-12, true)
  }
}

///|
test "the inverse solve lands the tip on the reference tip" {
  // The inverse is iterative, and a chain with more than two links has more than
  // one set of angles for the same tip, so the angles are not compared: what has
  // to hold is that the solved angles put the tip where the reference puts it.
  for case in pythonrobotics_arm_cases() {
    let arm = @kinematics.PlanarArm::new(lengths=case.links)
    let target = @linear.Vec::of(case.tip)
    // A folded start and a few hundred more iterations than the default: the
    // damped solve creeps along a chain this long, and the default budget is
    // tuned for the two-link case.
    let seed = @linear.Vec::of(Array::make(case.links.length(), 0.3))
    let solved = arm.solve(target~, seed~, iterations=2000, damping=0.02)
    let tip = arm.forward(solved)
    assert_eq((tip.get(0) - case.tip[0]).abs() <= 1.0e-6, true)
    assert_eq((tip.get(1) - case.tip[1]).abs() <= 1.0e-6, true)
  }
}
