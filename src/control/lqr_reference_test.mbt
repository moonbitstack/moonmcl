// The Riccati solver and the LQR gain against the references: the cost matrix a
// mature linear algebra library solves the equation to, and the gain a mature
// control library takes from it. The table is generated by
// `scripts/vectors/gen_control.py`.

///|
fn build_mat(values : Array[Double], rows : Int32, cols : Int32) -> @linear.Mat {
  let matrix = @linear.Mat::zeros(rows, cols)
  for i in 0..<rows {
    for j in 0..<cols {
      matrix.set(i, j, values[i * cols + j])
    }
  }
  matrix
}

///|
fn near(actual : Double, expected : Double, tolerance : Double) -> Bool {
  (actual - expected).abs() <= tolerance * (1.0 + expected.abs())
}

///|
fn same_mat(
  actual : @linear.Mat,
  expected : Array[Double],
  tolerance : Double,
) -> Bool {
  if actual.rows * actual.cols != expected.length() {
    return false
  }
  for i in 0..<actual.rows {
    for j in 0..<actual.cols {
      if !near(actual.get(i, j), expected[i * actual.cols + j], tolerance) {
        return false
      }
    }
  }
  true
}

///|
test "the Riccati solution matches the reference cost matrix" {
  let cases = lqr_cases()
  assert_eq(cases.length() >= 10, true)
  for case in cases {
    let a = build_mat(case.a, case.rows, case.columns)
    let b = build_mat(case.b, case.rows, case.inputs)
    let q = build_mat(case.q, case.rows, case.columns)
    let r = build_mat(case.r, case.inputs, case.inputs)
    let solution = @control.dare(a~, b~, q~, r~)
    // The reference solves the equation with a Schur decomposition and this
    // library iterates the recursion to a fixed point, so the two agree to the
    // tolerance the iteration stops at.
    assert_eq(same_mat(solution.cost, case.cost, 1.0e-8), true)
    assert_eq(same_mat(solution.gain, case.gain, 1.0e-8), true)
  }
}

///|
test "the regulator gain matches the reference gain" {
  for case in lqr_cases() {
    let a = build_mat(case.a, case.rows, case.columns)
    let b = build_mat(case.b, case.rows, case.inputs)
    let q = build_mat(case.q, case.rows, case.columns)
    let r = build_mat(case.r, case.inputs, case.inputs)
    let regulator = @control.lqr(a~, b~, q~, r~)
    assert_eq(same_mat(regulator.gain(), case.gain, 1.0e-8), true)
  }
}

///|
test "the replayed gains leave every plant stable" {
  for case in lqr_cases() {
    let a = build_mat(case.a, case.rows, case.columns)
    let b = build_mat(case.b, case.rows, case.inputs)
    let q = build_mat(case.q, case.rows, case.columns)
    let r = build_mat(case.r, case.inputs, case.inputs)
    let regulator = @control.lqr(a~, b~, q~, r~)
    let closed = a.sub(b.mul(regulator.gain()))
    // A closed loop is asymptotically stable exactly when its powers die out, so
    // the state is driven from a unit start and the norm read after enough steps.
    let mut state = @linear.Vec::zeros(case.rows)
    state.set(0, 1.0)
    for i in 1..<case.rows {
      state.set(i, 0.5)
    }
    for _ in 0..<2000 {
      state = closed.apply(state)
    }
    assert_eq(state.norm() < 1.0e-6, true)
  }
}
