// The three discretisation rules against SciPy's `cont2discrete`. The table is
// generated by `scripts/vectors/gen_discretize.py`: each case is a continuous
// plant and a period, and the expected values are the discrete state and input
// matrices the reference produces with `zoh`, `bilinear` and `euler`.
//
// The comparison is on `a` and `b` only. Every rule leaves the observation
// matrices alone, and `StateSpace::discretize` returns them unchanged, so there
// is nothing there for a reference to disagree with.

///|
fn discrete_mat(
  values : Array[Double],
  rows : Int32,
  cols : Int32,
) -> @linear.Mat {
  let matrix = @linear.Mat::zeros(rows, cols)
  for i in 0..<rows {
    for j in 0..<cols {
      matrix.set(i, j, values[i * cols + j])
    }
  }
  matrix
}

///|
fn discrete_close(
  actual : @linear.Mat,
  expected : Array[Double],
  rows : Int32,
  cols : Int32,
  tolerance : Double,
) -> Bool {
  if actual.rows != rows || actual.cols != cols {
    return false
  }
  for i in 0..<rows {
    for j in 0..<cols {
      let want = expected[i * cols + j]
      if (actual.get(i, j) - want).abs() > tolerance * (1.0 + want.abs()) {
        return false
      }
    }
  }
  true
}

///|
fn discretized(
  case : DiscretizeCase,
  rule : @contract.Discretize,
) -> @contract.StateSpace raise @linear.Refused {
  let plant = @contract.StateSpace::continuous(
    a=discrete_mat(case.a, case.n, case.n),
    b=discrete_mat(case.b, case.n, case.m),
    c=@linear.Mat::identity(case.n),
    d=@linear.Mat::zeros(case.n, case.m),
  )
  plant.discretize(dt=case.dt, discretize=rule)
}

///|
test "zero order hold matches the reference pair" {
  let cases = discretize_cases()
  assert_eq(cases.length() >= 18, true)
  for case in cases {
    let held = discretized(case, @contract.Zoh)
    assert_eq(discrete_close(held.a, case.zoh_a, case.n, case.n, 1.0e-12), true)
    assert_eq(discrete_close(held.b, case.zoh_b, case.n, case.m, 1.0e-12), true)
  }
}

///|
test "tustin matches the reference pair" {
  for case in discretize_cases() {
    let mapped = discretized(case, @contract.Tustin)
    assert_eq(
      discrete_close(mapped.a, case.tustin_a, case.n, case.n, 1.0e-12),
      true,
    )
    assert_eq(
      discrete_close(mapped.b, case.tustin_b, case.n, case.m, 1.0e-12),
      true,
    )
  }
}

///|
test "forward euler matches the reference pair" {
  for case in discretize_cases() {
    let stepped = discretized(case, @contract.ForwardEuler)
    assert_eq(
      discrete_close(stepped.a, case.euler_a, case.n, case.n, 1.0e-12),
      true,
    )
    assert_eq(
      discrete_close(stepped.b, case.euler_b, case.n, case.m, 1.0e-12),
      true,
    )
  }
}

///|
test "a discrete record keeps its period and refuses another" {
  let cases = discretize_cases()
  let case = cases[0]
  let held = discretized(case, @contract.Zoh)
  // Asking a discrete record for the period it already has returns it as it is.
  let again = held.discretize(dt=case.dt)
  assert_eq(again.is_discrete(), true)
  assert_eq(discrete_close(again.a, case.zoh_a, case.n, case.n, 1.0e-12), true)
  // Resampling would need the continuous plant, which the record no longer has.
  let resampled = try {
    let _ = held.discretize(dt=case.dt * 2.0)
    false
  } catch {
    @linear.Refused::Range(_) => true
    _ => false
  }
  assert_eq(resampled, true)
}

///|
test "a period that is not positive is refused" {
  let case = discretize_cases()[0]
  let plant = @contract.StateSpace::continuous(
    a=discrete_mat(case.a, case.n, case.n),
    b=discrete_mat(case.b, case.n, case.m),
    c=@linear.Mat::identity(case.n),
    d=@linear.Mat::zeros(case.n, case.m),
  )
  for bad in [0.0, -0.1] {
    let refused = try {
      let _ = plant.discretize(dt=bad)
      false
    } catch {
      @linear.Refused::Range(_) => true
      _ => false
    }
    assert_eq(refused, true)
  }
}

///|
test "a pole inside the circle stays there under hold and tustin" {
  // One pole at -20 and a period of half a second: the exact discrete pole is
  // e^-10, far inside the unit circle. Forward Euler puts it at 1 - 10 = -9,
  // which is the textbook reason a short-euler discretisation is not usable at a
  // long period; the hold and the trapezoidal rule both stay inside.
  let plant = @contract.StateSpace::continuous(
    a=@linear.Mat::of([[-20.0]]),
    b=@linear.Mat::of([[1.0]]),
    c=@linear.Mat::of([[1.0]]),
    d=@linear.Mat::of([[0.0]]),
  )
  let dt = 0.5
  let exact = @math.exp(-20.0 * dt)
  let held = plant.discretize(dt~, discretize=@contract.Zoh)
  let tustin = plant.discretize(dt~, discretize=@contract.Tustin)
  let euler = plant.discretize(dt~, discretize=@contract.ForwardEuler)
  assert_eq((held.a.get(0, 0) - exact).abs() < 1.0e-12, true)
  assert_eq(tustin.a.get(0, 0).abs() < 1.0, true)
  assert_eq(euler.a.get(0, 0).abs() > 1.0, true)
  // The input matrix follows the same rule: the hold integrates the input over
  // the period, which is (1 - e^-10) / 20 for this pole.
  assert_eq((held.b.get(0, 0) - (1.0 - exact) / 20.0).abs() < 1.0e-12, true)
  assert_eq((euler.b.get(0, 0) - dt).abs() < 1.0e-12, true)
}
