// The three Kalman filters against the estimates a mature filter library produces
// from the same prior, the same noise and the same measurements. The table is
// generated by `scripts/vectors/gen_filterpy.py`.

// --- the plant the nonlinear cases run on ---------------------------------

///|
/// A cart with quadratic drag and a quadratic position sensor: nonlinear in the
/// state, so the extended and unscented filters have to do real work.
struct Cart {}

///|
const DRAG : Double = 0.1

///|
impl @contract.Model for Cart with fn step(self, x, u, dt) {
  ignore(self)
  let position = x.get(0)
  let velocity = x.get(1)
  @linear.Vec::of([
    position + dt * velocity,
    velocity + dt * (u.get(0) - DRAG * velocity * velocity.abs()),
  ])
}

///|
impl @contract.Model for Cart with fn observe(self, x) {
  ignore(self)
  let velocity = x.get(1)
  @linear.Vec::of([x.get(0) + 0.05 * velocity * velocity])
}

///|
impl @contract.Model for Cart with fn step_jacobian(self, x, u, dt) {
  ignore(self)
  ignore(u)
  @linear.Mat::of([[1.0, dt], [0.0, 1.0 - 2.0 * DRAG * dt * x.get(1).abs()]])
}

///|
impl @contract.Model for Cart with fn observe_jacobian(self, x) {
  ignore(self)
  @linear.Mat::of([[1.0, 0.1 * x.get(1)]])
}

///|
pub extend Cart with @contract.Model::{
  step,
  observe,
  step_jacobian,
  observe_jacobian,
}

// --- the replay ------------------------------------------------------------

///|
fn mat_of(values : Array[Double], rows : Int32, cols : Int32) -> @linear.Mat {
  let matrix = @linear.Mat::zeros(rows, cols)
  for i in 0..<rows {
    for j in 0..<cols {
      matrix.set(i, j, values[i * cols + j])
    }
  }
  matrix
}

///|
fn vec_of(values : Array[Double]) -> @linear.Vec {
  @linear.Vec::of(values)
}

///|
fn near(actual : Double, expected : Double, tolerance : Double) -> Bool {
  (actual - expected).abs() <= tolerance * (1.0 + expected.abs())
}

///|
fn same_vec(
  actual : @linear.Vec,
  expected : Array[Double],
  tolerance : Double,
) -> Bool {
  if actual.len() != expected.length() {
    return false
  }
  for i in 0..<actual.len() {
    if !near(actual.get(i), expected[i], tolerance) {
      return false
    }
  }
  true
}

///|
fn same_mat(
  actual : @linear.Mat,
  expected : Array[Double],
  tolerance : Double,
) -> Bool {
  if actual.rows * actual.cols != expected.length() {
    return false
  }
  for i in 0..<actual.rows {
    for j in 0..<actual.cols {
      if !near(actual.get(i, j), expected[i * actual.cols + j], tolerance) {
        return false
      }
    }
  }
  true
}

///|
test "the linear filter follows the reference estimate" {
  let cases = filterpy_linear_cases()
  assert_eq(cases.length() >= 2, true)
  for case in cases {
    let n = case.prior.length()
    let model = @contract.StateSpace::discrete(
      a=@linear.Mat::of([[1.0, case.dt], [0.0, 1.0]]),
      b=@linear.Mat::zeros(2, 1),
      c=@linear.Mat::of([[1.0, 0.0]]),
      d=@linear.Mat::zeros(1, 1),
      dt=case.dt,
    )
    let filter = @estimation.Kalman::new(
      model~,
      process=mat_of(case.process, n, n),
      measurement=@linear.Mat::of([[case.measurement]]),
      state=vec_of(case.prior),
      covariance=mat_of(case.covariance, n, n),
    )
    for k in 0..<case.measurements.length() {
      filter.predict(@linear.Vec::zeros(1), case.dt)
      filter.correct(@linear.Vec::of([case.measurements[k]]))
      assert_eq(same_vec(filter.state, case.states[k], 1.0e-9), true)
      assert_eq(same_mat(filter.covariance, case.covariances[k], 1.0e-9), true)
    }
  }
}

///|
test "the extended filter follows the reference estimate on a nonlinear plant" {
  for case in filterpy_extended_cases() {
    let n = case.prior.length()
    let model : &@contract.Model = Cart::{ }
    let filter = @estimation.ExtendedKalman::new(
      model~,
      process=mat_of(case.process, n, n),
      measurement=@linear.Mat::of([[case.measurement]]),
      state=vec_of(case.prior),
      covariance=mat_of(case.covariance, n, n),
    )
    for k in 0..<case.measurements.length() {
      filter.predict(@linear.Vec::zeros(1), case.dt)
      filter.correct(@linear.Vec::of([case.measurements[k]]))
      assert_eq(same_vec(filter.state, case.states[k], 1.0e-9), true)
      assert_eq(same_mat(filter.covariance, case.covariances[k], 1.0e-9), true)
    }
  }
}

///|
test "the unscented filter follows the reference estimate on a nonlinear plant" {
  // The reference takes the matrix square root by Cholesky and this library takes
  // it by symmetric eigen decomposition, so the sigma points differ in the last
  // digits and the two covariances with them; the tolerance is loose enough to
  // cover that and tight enough that a wrong weight shows.
  for case in filterpy_unscented_cases() {
    let n = case.prior.length()
    let model : &@contract.Model = Cart::{ }
    let filter = @estimation.UnscentedKalman::new(
      model~,
      process=mat_of(case.process, n, n),
      measurement=@linear.Mat::of([[case.measurement]]),
      state=vec_of(case.prior),
      covariance=mat_of(case.covariance, n, n),
    )
    for k in 0..<case.measurements.length() {
      filter.predict(@linear.Vec::zeros(1), case.dt)
      filter.correct(@linear.Vec::of([case.measurements[k]]))
      assert_eq(same_vec(filter.state, case.states[k], 1.0e-7), true)
      assert_eq(same_mat(filter.covariance, case.covariances[k], 1.0e-7), true)
    }
  }
}
