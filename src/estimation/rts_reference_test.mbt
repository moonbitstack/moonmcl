// The backward smoothing pass against filterpy. The table is generated by
// `scripts/vectors/gen_rts.py`: each case is a recorded forward run — the
// filtered means and covariances the reference held after every update — and the
// smoothed means and covariances it makes of them. Feeding this library the
// reference's own record separates a smoother that disagrees from a filter that
// does.

///|
/// The transition matrix repeated between every pair of consecutive steps.
fn rts_transitions(case : RtsCase, steps : Int32) -> Array[@linear.Mat] {
  let transitions = []
  for _ in 1..<steps {
    transitions.push(mat_of(case.transition, case.n, case.n))
  }
  transitions
}

///|
test "the smoothed pass follows the reference" {
  let cases = rts_cases()
  assert_eq(cases.length() >= 5, true)
  for case in cases {
    let steps = case.states.length()
    let states = case.states.map(fn(row) { vec_of(row) })
    let covariances = case.covariances.map(fn(row) {
      mat_of(row, case.n, case.n)
    })
    let (smoothed_states, smoothed_covariances) = @estimation.rts(
      states~,
      covariances~,
      transitions=rts_transitions(case, steps),
      process=mat_of(case.process, case.n, case.n),
    )
    assert_eq(smoothed_states.length(), steps)
    for k in 0..<steps {
      assert_eq(
        same_vec(smoothed_states[k], case.smoothed_states[k], 1.0e-9),
        true,
      )
      assert_eq(
        same_mat(smoothed_covariances[k], case.smoothed_covariances[k], 1.0e-9),
        true,
      )
    }
  }
}

///|
test "the last step is where the filter left it" {
  // The backward pass starts from the final estimate and rewrites everything
  // before it, so the last entry has to come back untouched on every case.
  for case in rts_cases() {
    let steps = case.states.length()
    let states = case.states.map(fn(row) { vec_of(row) })
    let covariances = case.covariances.map(fn(row) {
      mat_of(row, case.n, case.n)
    })
    let (smoothed_states, smoothed_covariances) = @estimation.rts(
      states~,
      covariances~,
      transitions=rts_transitions(case, steps),
      process=mat_of(case.process, case.n, case.n),
    )
    let last = steps - 1
    assert_eq(same_vec(smoothed_states[last], case.states[last], 1.0e-12), true)
    assert_eq(
      same_mat(smoothed_covariances[last], case.covariances[last], 1.0e-12),
      true,
    )
  }
}

///|
test "smoothing never widens a covariance" {
  // The backward pass adds information, so the trace of every smoothed
  // covariance is at most the trace of the filtered one it replaced.
  for case in rts_cases() {
    let steps = case.states.length()
    let covariances = case.covariances.map(fn(row) {
      mat_of(row, case.n, case.n)
    })
    let (_, smoothed) = @estimation.rts(
      states=case.states.map(fn(row) { vec_of(row) }),
      covariances~,
      transitions=rts_transitions(case, steps),
      process=mat_of(case.process, case.n, case.n),
    )
    for k in 0..<steps {
      assert_eq(smoothed[k].trace() <= covariances[k].trace() + 1.0e-12, true)
    }
  }
}

///|
test "a record of one step comes back unchanged" {
  // With nothing to look back on, the pass is the identity.
  let states = [vec_of([0.5, -1.0])]
  let covariances = [mat_of([2.0, 0.1, 0.1, 3.0], 2, 2)]
  let (smoothed_states, smoothed_covariances) = @estimation.rts(
    states~,
    covariances~,
    transitions=[],
    process=@linear.Mat::identity(2),
  )
  assert_eq(same_vec(smoothed_states[0], [0.5, -1.0], 1.0e-15), true)
  assert_eq(
    same_mat(smoothed_covariances[0], [2.0, 0.1, 0.1, 3.0], 1.0e-15),
    true,
  )
}

///|
test "a record with no steps is refused" {
  let refused = try {
    let _ = @estimation.rts(
      states=[],
      covariances=[],
      transitions=[],
      process=@linear.Mat::identity(2),
    )
    false
  } catch {
    @linear.Refused::Empty => true
    _ => false
  }
  assert_eq(refused, true)
}

///|
test "a record whose covariances do not match its states is refused" {
  let refused = try {
    let _ = @estimation.rts(
      states=[vec_of([0.0, 0.0]), vec_of([1.0, 1.0])],
      covariances=[@linear.Mat::identity(2)],
      transitions=[@linear.Mat::identity(2)],
      process=@linear.Mat::identity(2),
    )
    false
  } catch {
    @linear.Refused::Dimension(_) => true
    _ => false
  }
  assert_eq(refused, true)
}
