  "path-planning",
  "grid",
  "kinematics",
  "differential-drive",
  "inverse-kinematics",
  "robot",
  "embedded",
  "game",
  "physics",
  "mctl",
]

description = "MoonBit Motion Control Library: a pure MoonBit collection of classical and modern motion-control algorithms (PID, LQR, MPC, Kalman filtering, path planning and kinematics), depending only on the official standard library."

source = "src"
