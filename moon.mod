license = "Apache-2.0"

keywords = [
  "moonbit",
  "mcl",
  "motion-control",
  "robotics",
  "control",
  "pid",
  "pid-controller",
  "feedforward",
  "s-curve",
  "jerk",
  "trajectory",
  "trapezoidal",
  "lqr",
  "mpc",
